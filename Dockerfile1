# Stage 1: Build the application
# Use the official .NET SDK image based on Ubuntu (e.g., 8.0-ubuntu)
FROM ubuntu:22.04 AS build-env

# Install .NET SDK
RUN apt-get update && \
    apt-get install -y wget && \
    wget https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && \
    rm packages-microsoft-prod.deb && \
    apt-get update && \
    apt-get install -y dotnet-sdk-8.0

WORKDIR /app

# Copy the project files and restore dependencies
# Use a wildcard to copy csproj files first to leverage Docker's build cache
COPY *.csproj ./
RUN dotnet restore

# Copy the rest of the application code
COPY . .

# Build the application
RUN dotnet publish -c Release -o out


# Stage 2: Create the runtime image
FROM ubuntu:22.04 AS runtime

# Install .NET Runtime
RUN apt-get update && \
    apt-get install -y wget && \
    wget https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && \
    rm packages-microsoft-prod.deb && \
    apt-get update && \
    apt-get install -y aspnetcore-runtime-8.0

WORKDIR /app

# Copy the published application from the build stage
COPY --from=build-env /app/out .

# Expose the port your API listens on (e.g., 80 for HTTP)
EXPOSE 5000

# Define the entry point for the container
ENTRYPOINT ["dotnet","AWS_CICD_Test.dll"]